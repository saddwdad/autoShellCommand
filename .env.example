# autoshell daemon 从用户目录固定读取此文件：~/.autoshell/.env
# 打包后不再从项目根目录读 .env，把机密放到这里（asf serve 从任意目录起都能读到）。
# 注意：不要提交含真实机密的本文件到 git（本仓库 .gitignore 已排除 *.env）。

# 服务端监听端口（默认 3000，可用 asf serve --port 覆盖）
PORT=3000

# 反馈列表的管理密码：只有请求头 X-Admin-Password 等于这个值，才能拉取反馈列表。
# 别留空，留空 = 谁都不能看反馈列表。
ADMIN_PASSWORD=

# 以下 Supabase 三件套里，URL 和 ANON_KEY 已内联进代码（公开无害），可不填、只作覆盖用。
# SERVICE_KEY（service_role，能绕过 RLS 读所有数据）是真正机密，只在管理员本机配，绝不进包/上传。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
